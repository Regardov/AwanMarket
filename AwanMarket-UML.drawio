  <diagram id="awan-4" name="04 Классы ORM">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Классы · Модель данных" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#172b45;text;align=left;fontSize=27;fontStyle=1;fontColor=#14263d;" vertex="1" parent="1">
          <mxGeometry x="32" y="15" width="1236" height="42" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="backend/app/models.py · SQLAlchemy  •  PK — первичный ключ, FK — внешний ключ" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#172b45;text;align=left;fontSize=13;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="33" y="61" width="1234" height="32" as="geometry" />
        </mxCell>
        <mxCell id="base" value="&lt;div style=&quot;text-align:center;background:#dbeaf8;padding:5px&quot;&gt;&lt;span style=&quot;font-size:11px&quot;&gt;«базовый класс»&lt;/span&gt;&lt;br&gt;&lt;b&gt;Base&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding:7px 9px;border-top:1px solid #7394b5&quot;&gt;Наследует DeclarativeBase&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#172b45;strokeColor=#7394b5;fillColor=#ffffff;align=left;verticalAlign=top;spacing=0;overflow=fill;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="525" y="107" width="216" height="66" as="geometry" />
        </mxCell>
        <mxCell id="role" value="&lt;div style=&quot;text-align:center;background:#dbeaf8;padding:5px&quot;&gt;&lt;span style=&quot;font-size:11px&quot;&gt;«enum»&lt;/span&gt;&lt;br&gt;&lt;b&gt;UserRole&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding:7px 9px;border-top:1px solid #7394b5&quot;&gt;customer&lt;br&gt;admin&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#172b45;strokeColor=#7394b5;fillColor=#ffffff;align=left;verticalAlign=top;spacing=0;overflow=fill;fontSize=13;" vertex="1" parent="1">
